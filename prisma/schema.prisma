generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  /// Relations load in the same SQL statement (one round trip) instead of one query per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  owner
  admin
  member
}

enum SplitMethod {
  amount
  shares
  percentage
}

enum Channel {
  email
  telegram
}

enum MethodKind {
  bank
  link
  qr
  other
}

/// A person. Signs in with a code sent by email, or by Telegram to their phone number (E.164).
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?  @unique
  phone     String?  @unique
  locale    String   @default("ar") @db.VarChar(2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions       Session[]
  memberships    GroupMember[]
  paymentMethods PaymentMethod[]

  @@map("users")
}

/// Revocable login. The cookie holds a signed JWT with this id.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One-time sign-in code. Only the hash is stored.
model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  channel    Channel
  codeHash   String   @map("code_hash")
  attempts   Int      @default(0) @db.SmallInt
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

/// Phone (E.164) -> Telegram chat, written when the user shares their own contact with the bot.
model TelegramChat {
  phone     String   @id
  chatId    BigInt   @unique @map("chat_id")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("telegram_chats")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  currency    String   @default("SAR") @db.Char(3)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members        GroupMember[]
  activities     Activity[]
  paymentMethods PaymentMethod[]

  @@map("groups")
}

/// Paying members owe every activity starting on or after `startsOn`.
/// Other members owe only activities they are listed on (activity_members).
/// split_method/split_value is the default rule; null means it must be set per activity.
model GroupMember {
  groupId     String       @map("group_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        Role         @default(member)
  isPaying    Boolean      @default(false) @map("is_paying")
  startsOn    DateTime     @default(now()) @map("starts_on") @db.Date
  splitMethod SplitMethod? @map("split_method")
  splitValue  Decimal?     @map("split_value") @db.Decimal(14, 4)

  group            Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  activityEntries  ActivityMember[]
  paymentsMade     Payment[]        @relation("PaymentPayer")
  paymentsReceived Payment[]        @relation("PaymentPayee")
  reminders        Reminder[]
  fills            ActivityFill[]

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Activity {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  title     String
  startsOn  DateTime  @default(now()) @map("starts_on") @db.Date
  /// Set when an admin closes it: dues are frozen into activity_members and expenses can't change (DB trigger).
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  group    Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members  ActivityMember[]
  expenses Expense[]
  payments Payment[]
  fills    ActivityFill[]

  @@unique([id, groupId])
  @@index([groupId, startsOn(sort: Desc)])
  @@map("activities")
}

/// Lists an other member on an activity, or overrides a member's rule for this activity.
model ActivityMember {
  activityId  String       @map("activity_id") @db.Uuid
  groupId     String       @map("group_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  splitMethod SplitMethod? @map("split_method")
  splitValue  Decimal?     @map("split_value") @db.Decimal(14, 4)

  activity Activity    @relation(fields: [activityId, groupId], references: [id, groupId], onDelete: Cascade)
  member   GroupMember @relation(fields: [groupId, userId], references: [groupId, userId], onDelete: Cascade)

  @@id([activityId, userId])
  @@index([groupId])
  @@map("activity_members")
}

model Expense {
  id           String    @id @default(uuid()) @db.Uuid
  groupId      String    @map("group_id") @db.Uuid
  activityId   String    @map("activity_id") @db.Uuid
  title        String
  amount       Int
  receiptPath  String?   @map("receipt_path")
  /// Sealed = fixed amount: it can't be changed, deleted or unsealed (DB trigger). Unsealed amounts can be edited.
  sealed       Boolean   @default(false)
  /// Null while waiting for an admin; pending rows are not part of the ledger.
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById String?   @map("approved_by_id") @db.Uuid
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId, groupId], references: [id, groupId], onDelete: Cascade)

  @@index([groupId, activityId])
  @@map("expenses")
}

/// Part of an activity's shortfall covered by a member's surplus (credit) through the group budget.
/// Not a payment: balances don't change. It counts as that member's contribution to this activity,
/// and only the part still needed (expenses - tagged payments) is effective.
model ActivityFill {
  activityId  String   @map("activity_id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Int
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity    @relation(fields: [activityId, groupId], references: [id, groupId], onDelete: Cascade)
  member   GroupMember @relation(fields: [groupId, userId], references: [groupId, userId], onDelete: Restrict)

  @@id([activityId, userId])
  @@index([groupId])
  @@map("activity_fills")
}

/// The only record of money paid. payee null = paid into the group;
/// payee set = paid to that member, which deducts from what the payee has paid.
model Payment {
  id           String    @id @default(uuid()) @db.Uuid
  groupId      String    @map("group_id") @db.Uuid
  activityId   String?   @map("activity_id") @db.Uuid
  payerId      String    @map("payer_id") @db.Uuid
  payeeId      String?   @map("payee_id") @db.Uuid
  amount       Int
  paidOn       DateTime  @default(now()) @map("paid_on") @db.Date
  note         String?
  receiptPath  String?   @map("receipt_path")
  /// Null while waiting for an admin; pending rows are not part of the ledger.
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById String?   @map("approved_by_id") @db.Uuid
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity?    @relation(fields: [activityId, groupId], references: [id, groupId], onDelete: Restrict)
  payer    GroupMember  @relation("PaymentPayer", fields: [groupId, payerId], references: [groupId, userId], onDelete: Restrict)
  payee    GroupMember? @relation("PaymentPayee", fields: [groupId, payeeId], references: [groupId, userId], onDelete: Restrict)

  @@index([groupId, paidOn(sort: Desc)])
  @@index([activityId])
  @@map("payments")
}

/// How to pay someone: a member's own account, or the group's account. Exactly one owner.
model PaymentMethod {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  groupId     String?    @map("group_id") @db.Uuid
  kind        MethodKind
  label       String
  iban        String?
  beneficiary String?
  linkUrl     String?    @map("link_url")
  qrPath      String?    @map("qr_path")
  details     String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@map("payment_methods")
}

/// Sent reminder: the log, and the source for the per-member rate limit.
model Reminder {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  sentById String   @map("sent_by_id") @db.Uuid
  channel  Channel
  amount   Int
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  member GroupMember @relation(fields: [groupId, userId], references: [groupId, userId], onDelete: Cascade)

  @@index([groupId, userId, sentAt(sort: Desc)])
  @@map("reminders")
}
