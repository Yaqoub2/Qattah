# App
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Postgres. App queries use DATABASE_URL; prisma migrate uses DIRECT_URL.
# Local (docker compose):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Supabase: DATABASE_URL = transaction pooler (port 6543), DIRECT_URL = direct or session pooler (port 5432)
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Receipts and QR images: Supabase Storage, private bucket
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qattah

# Email codes and reminders (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Qattah <noreply@example.com>

# Telegram codes and reminders (addressed by phone number): bot token from @BotFather, webhook secret you choose, bot username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT=

# Dev only: print codes to the server log when a channel is not configured
AUTH_DEV_LOG_OTP=true
