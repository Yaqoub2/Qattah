# App
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Local Postgres (docker compose). Prisma uses DIRECT_URL when set.
#   npm run db:up && npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Hosted Supabase Postgres (production / shared cloud)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=5
# DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New Supabase dashboard: Publishable key. Legacy name: anon key (either works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=qattah

# WhatsApp Cloud API (OTP + reminders)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=qattah_otp

# SMTP (email OTP + reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=قطة <noreply@example.com>

# Dev: log OTP to console when WhatsApp/SMTP are unset
AUTH_DEV_LOG_OTP=true
